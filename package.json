{
  "name": "@local/dsh-gitlab-todo-agent",
  "version": "1.7.0",
  "private": false,
  "description": "GitLab Todo watcher for DeepSeek Harness: reads your GitLab todos via glab, opens isolated DSH sessions for direct comment mentions from other users, with running-session concurrency control.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifeipkg/dsh-gitlab-todo-agent.git"
  },
  "bugs": {
    "url": "https://github.com/lifeipkg/dsh-gitlab-todo-agent/issues"
  },
  "homepage": "https://github.com/lifeipkg/dsh-gitlab-todo-agent#readme",
  "author": "lifeipkg",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "gitlab",
    "todo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tests/*.test.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
