{
  "name": "dsh-gitlab-todo-agent",
  "version": "2.13.0",
  "description": "DSH bundle: poll GitLab todos via glab and dispatch comment mentions to DSH sessions with closed-loop verification.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifeipkg/dsh-gitlab-todo-agent.git"
  },
  "homepage": "https://github.com/lifeipkg/dsh-gitlab-todo-agent#readme",
  "bugs": {
    "url": "https://github.com/lifeipkg/dsh-gitlab-todo-agent/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "gitlab",
    "todo",
    "agent",
    "glab"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./host": "./dsh-host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "dsh-host.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tests/*.test.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
