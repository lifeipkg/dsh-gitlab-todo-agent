{
  "name": "@local/dsh-gitlab-todo-agent",
  "version": "1.9.1",
  "private": true,
  "description": "Poll GitLab todos directly with glab and dispatch direct comment mentions to DSH sessions.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tests/*.test.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
