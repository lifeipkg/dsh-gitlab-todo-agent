{
  "name": "@lifeipkg/dsh-gitlab-todo-agent",
  "version": "2.28.0",
  "description": "DSH bundle: poll GitLab todos via glab, batch-precheck mentions, route them to sessions, verify closure and surface an inbox for human follow-up.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "lifeipkg",
    "url": "https://github.com/lifeipkg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifeipkg/dsh-gitlab-todo-agent.git"
  },
  "homepage": "https://github.com/lifeipkg/dsh-gitlab-todo-agent#readme",
  "bugs": {
    "url": "https://github.com/lifeipkg/dsh-gitlab-todo-agent/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./host": "./dsh-host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "dsh-host.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "tests/*.test.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js && node --check host/constants.js && node --check host/util.js && node --check host/gitlab.js && node --check host/precheck.js && node --check host/precheck-jev.js && node --check host/slots.js && node --check host/closures.js && node --check host/followups.js && node --check host/dispatch.js",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "gitlab",
    "todo",
    "agent",
    "glab",
    "cordis"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
